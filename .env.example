# Server-only settings. Never commit real values or enter provider keys in HTML.
PORT=3000
BIND_HOST=0.0.0.0
# Render provides RENDER_EXTERNAL_URL automatically: leave these unset there.
# For another host, set both to the new private website's HTTPS origin.
FRONTEND_ORIGIN=
BACKEND_PUBLIC_URL=
WORKSPACE_PASSWORD=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OWNER_EMAIL=
# Base64 encoded random 32-byte AES key for private OAuth-token storage.
TOKEN_ENCRYPTION_KEY=
